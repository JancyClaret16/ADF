						"          store_id as string,",
						"          store_name as string,",
						"          store_location as string,",
						"          date_id as date,",
						"          sale_date as string,",
						"          quantity_sold as double,",
						"          unit_price as double,",
						"          discount as double,",
						"          total_amount as string,",
						"          payment_id as string,",
						"          payment_method as string,",
						"          payment_status as string",
