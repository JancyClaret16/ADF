{
	"name": "transformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dataflowtransformation",
						"type": "DatasetReference"
					},
					"name": "dataflowspmrkt"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dataflowsink",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "selectcolms"
				},
				{
					"name": "filterrows"
				},
				{
					"name": "condsplit"
				},
				{
					"name": "derivedColumn"
				},
				{
					"name": "alterRow"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fact_id as short,",
				"          customer_id as string,",
				"          customer_name as string,",
				"          customer_phone as long,",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          brand as string,",
				"          store_id as string,",
				"          store_name as string,",
				"          store_location as string,",
				"          date_id as date,",
				"          sale_date as string,",
				"          quantity_sold as double,",
				"          unit_price as double,",
				"          discount as double,",
				"          total_amount as string,",
				"          payment_id as string,",
				"          payment_method as string,",
				"          payment_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dataflowspmrkt",
				"dataflowspmrkt select(mapColumn(",
				"          fact_id,",
				"          customer_id,",
				"          customer_name,",
				"          product_id,",
				"          product_name,",
				"          payment_id,",
				"          payment_method,",
				"          payment_status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectcolms",
				"selectcolms filter(customer_id!=\"C001\") ~> filterrows",
				"filterrows split(payment_method==\"UPI\",",
				"     disjoint: false) ~> condsplit@(UPI, otherthanUPI)",
				"condsplit@otherthanUPI derive(payment_status = coalesce(payment_status,'N/A')) ~> derivedColumn",
				"derivedColumn alterRow(insertIf(2==2)) ~> alterRow",
				"alterRow sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink"
			]
		}
	}
}